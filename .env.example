# ================================================================
# AROGYADHAM SWASTHYA KUTIR — ENVIRONMENT VARIABLES
# ================================================================

# Server Port
PORT=3000

# ----------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Get your Key ID and Secret from: https://dashboard.razorpay.com/app/keys
# ----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ----------------------------------------------------------------
# 2. FIREBASE WEB CONFIGURATION (Auth & Firestore)
# Get these from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your Project -> Project Settings -> General -> "Your apps" (Web </> )
# 3. Enable Authentication (Google Provider + Email/Password Provider)
# 4. Enable Cloud Firestore Database (Production or Test mode)
# ----------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyYOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=arogyadham-chitrakoot.firebaseapp.com
FIREBASE_PROJECT_ID=arogyadham-chitrakoot
FIREBASE_STORAGE_BUCKET=arogyadham-chitrakoot.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
